# ===================================
# PRODUCCIÓN - TINCHO BARBERÍA
# ===================================
# ⚠️ IMPORTANTE: Este archivo contiene la configuración para producción
# Copiar a .env en el servidor de producción

# ============================================
# DJANGO SETTINGS
# ============================================

# SECRET_KEY - ⚠️ CRÍTICO: Generar una nueva clave única
# Ejecutar: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CAMBIAR-POR-CLAVE-SUPER-SEGURA-DE-50-CARACTERES-MINIMO

# DEBUG - ⚠️ DEBE SER False EN PRODUCCIÓN
DEBUG=False

# ALLOWED_HOSTS - Tus dominios reales separados por comas
ALLOWED_HOSTS=tudominio.com,www.tudominio.com,api.tudominio.com

# ============================================
# DATABASE - PostgreSQL
# ============================================

DB_ENGINE=django.db.backends.postgresql
DB_NAME=tincho_barberia_prod
DB_USER=tincho_user
DB_PASSWORD=tu_password_super_seguro_aqui
DB_HOST=localhost
DB_PORT=5432

# ============================================
# CORS - URLs del Frontend
# ============================================

# Dominios permitidos para hacer requests al backend
# Usar HTTPS en producción
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# ============================================
# SERVICIOS
# ============================================

# ID del servicio por defecto (verificar en la base de datos)
# python manage.py shell
# from turnos.models import Servicio
# Servicio.objects.all()
DEFAULT_SERVICE_ID=1

# ============================================
# LOCALE
# ============================================

LANGUAGE_CODE=es-ar
TIME_ZONE=America/Argentina/Buenos_Aires

# ============================================
# SEGURIDAD ADICIONAL (Opcional pero recomendado)
# ============================================

# Cookies seguras (solo HTTPS)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

# HSTS (HTTP Strict Transport Security)
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ============================================
# NOTAS
# ============================================
# 1. NUNCA commitear este archivo con valores reales a Git
# 2. Generar SECRET_KEY único de 50+ caracteres
# 3. Usar contraseñas fuertes para la base de datos
# 4. Verificar que ALLOWED_HOSTS coincide con tus dominios
# 5. CORS_ALLOWED_ORIGINS debe usar https:// en producción
