# ===================================
# BACKEND DEMO - Variables de Entorno
# ===================================
# ARCHIVO: .env (en el servidor PythonAnywhere)

SECRET_KEY=demo-secret-key-change-this-in-production-xyz789abc

DEBUG=False

# Hosts permitidos
ALLOWED_HOSTS=tinchobarberdemo.pythonanywhere.com

# CORS - Permite el frontend de Vercel (rama demo)
# NOTA: Vercel genera URLs automáticas para cada branch
# Patrón: tincho-barberia-git-<branch>-<username>.vercel.app
CORS_ALLOWED_ORIGINS=https://tincho-barberia-git-demo-nicolas-projects-962652f9.vercel.app,https://tincho-barberia-git-demo-nicolasgomez268.vercel.app

# O usa regex para permitir cualquier deployment de demo:
# CORS_ALLOWED_ORIGIN_REGEXES=^https://tincho-barberia-git-demo-.*\.vercel\.app$

# Base de datos (SQLite por defecto)
DATABASE_URL=sqlite:///db.sqlite3

# Email (opcional, para notificaciones)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
