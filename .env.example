# ===================================
# TINCHO BARBERÍA - Configuración
# ===================================
# Copia este archivo a .env y configura tus valores

# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (opcional - por defecto usa SQLite)
# Para producción, usa PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=tincho_barberia_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# CORS (Frontend URLs permitidas)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Servicio por defecto (ID del servicio en la base de datos)
# Cambiar según tu configuración de producción
DEFAULT_SERVICE_ID=11

# Locale
LANGUAGE_CODE=es-ar
TIME_ZONE=America/Argentina/Buenos_Aires
